# Octopus server environment configuration
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.

# --- Model / provider keys ---
# At least one provider key is required for the agent to run.
OPENAI_API_KEY=sk-your-openai-key-here
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=

# --- Server ---
# Port the Hono server listens on (default 9876)
OCTOPUS_WEB_PORT=9876

# Log level: DEBUG | INFO | WARN | ERROR (default INFO)
OCTOPUS_LOG_LEVEL=INFO

# --- Agent behavior ---
# Override the default model (format: provider:model, e.g. openai:gpt-4o)
# OCTOPUS_MODEL=
# Auto-approve all tool calls without HITL prompt (default false)
# OCTOPUS_AUTO_APPROVE=false
# Enable interactive HITL mode (default true)
# OCTOPUS_INTERACTIVE=true
# Enable shell execution tool (default false)
# OCTOPUS_ENABLE_SHELL=false
# Enable web search tool (default true)
# OCTOPUS_ENABLE_WEB_SEARCH=true

# --- Storage ---
# Path to the SQLite database (default data/octopus.db).
# Relative paths resolve against the server process working directory (server/).
# OCTOPUS_DB_PATH=data/octopus.db

# --- LangSmith tracing (optional) ---
# Trace every model/tool call to https://smith.langchain.com for debugging.
# Free tier: 5,000 traces/month. Register at smith.langchain.com for an API key.
#
# Octopus uses its own OCTOPUS_LANGSMITH_TRACING_* namespace to stay isolated
# from the LANGSMITH_* vars that deepagents Sandbox reuses. At server startup
# these are synced into the standard LANGSMITH_* vars that @langchain/core
# reads, but only if those vars are not already set in the shell (so existing
# Sandbox configs are not clobbered).
#
# OCTOPUS_LANGSMITH_TRACING=true
# OCTOPUS_LANGSMITH_TRACING_API_KEY=lsv2_sk_your_langsmith_key
# OCTOPUS_LANGSMITH_TRACING_PROJECT=octopus-dev
# OCTOPUS_LANGSMITH_TRACING_ENDPOINT=https://api.smith.langchain.com

