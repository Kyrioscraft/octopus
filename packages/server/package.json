{
  "name": "@octopus/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "dev": "concurrently -n tsc,node \"tsc --watch --preserveWatchOutput\" \"node --watch --watch-path=src dist/main.js\"",
    "start": "node dist/main.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@hono/zod-validator": "^0.8.0",
    "@langchain/langgraph": "^1.4.0",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.3",
    "@node-rs/argon2": "^2.0.0",
    "@octopus/core": "workspace:*",
    "@octopus/extension-ripgrep": "workspace:*",
    "adm-zip": "^0.6.0",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.7.0",
    "jose": "^5.10.0",
    "uuid": "^11.1.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "concurrently": "^10.0.3",
    "typescript": "^5.7.0"
  }
}
