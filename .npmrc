# Resolve React to a single physical instance across the workspace.
#
# Without this, pnpm's isolated node_modules layout places a *separate copy*
# of `react` inside `node_modules/.pnpm/react-reconciler@.../node_modules/react`,
# so Ink's reconciler and the TUI's own code end up with two different React
# module objects at runtime. The reconciler installs its dispatcher on one
# instance while `useApp()`/`useState()` read from the other, producing
# "Invalid hook call. Hooks can only be called inside of the body of a
# function component." at startup.
#
# Hoisting `react` (and its tight-coupled peers) to the top-level node_modules
# makes every `require('react')` / `import 'react'` resolve to the same file,
# which is required for any custom React renderer (Ink, react-three-fiber,
# react-pdf, …) to work under pnpm.
public-hoist-pattern[]=react
public-hoist-pattern[]=react-dom
public-hoist-pattern[]=scheduler
public-hoist-pattern[]=react-reconciler
