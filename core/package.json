    "build": "node -e \"const{rmSync,cpSync}=require('fs');try{rmSync('dist/built_in_skills',{recursive:true,force:true})}catch{};cpSync('src/built_in_skills','dist/built_in_skills',{recursive:true})\" && tsc",
