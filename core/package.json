    "@langchain/openai": "^1.1.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "deepagents": "^1.10.0",
    "turndown": "^7.2.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "undici-types": "^6.21.0"
  }
}
