# Octopus server environment configuration
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.

# --- Model / provider keys ---
# At least one provider key is required for the agent to run.
OPENAI_API_KEY=sk-your-openai-key-here
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=

# --- Server ---
# Port the Hono server listens on (default 9876)
OCTOPUS_WEB_PORT=9876

# Log level: DEBUG | INFO | WARN | ERROR (default INFO)
OCTOPUS_LOG_LEVEL=INFO

# --- Agent behavior ---
# Override the default model (format: provider:model, e.g. openai:gpt-4o)
# OCTOPUS_MODEL=
# Auto-approve all tool calls without HITL prompt (default false)
# OCTOPUS_AUTO_APPROVE=false
# Enable interactive HITL mode (default true)
# OCTOPUS_INTERACTIVE=true
# Enable shell execution tool (default false)
# OCTOPUS_ENABLE_SHELL=false
# Enable web search tool (default true)
# OCTOPUS_ENABLE_WEB_SEARCH=true

# --- Storage ---
# Path to the SQLite database (default data/octopus.db).
# Relative paths resolve against the server process working directory (server/).
# OCTOPUS_DB_PATH=data/octopus.db
